{
  "name": "louise-castelatto",
  "private": false,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.1",
      "@types/react-dom": "18.3.1"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.18.0",
    "ajv": "^8.13.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "react-aria": "3.50.0",
    "react-stately": "3.48.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  },
  "dependencies": {
    "motion": "^11.15.0",
    "react-aria": "3.50.0",
    "react-stately": "3.48.0"
  }
}
